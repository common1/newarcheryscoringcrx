from django.db import models

from website.models import WebPage

from wagtail.admin.panels import (
    FieldPanel,
    HelpPanel,
    MultiFieldPanel,
    InlinePanel,
    PageChooserPanel,
    PublishingPanel,
    FieldRowPanel,
    MultipleChooserPanel,
    TitleFieldPanel,
)

from .models import (
    Archer,
    Discipline,
    DisciplineMembership,
    Club,
    ClubMembership,
)

class ArcherWebPage(WebPage):
    """
    Web page for displaying archer information.
    """
    
    class Meta:
        verbose_name = "Archer Web Page"

    archer_page = models.ForeignKey(
        Archer,
        null=True,
        blank=True,
        on_delete=models.SET_NULL,
        related_name='+',
        verbose_name=_("Archer"),
        help_text=_("Select the archer to display on this page."),
    )

    content_panels = WebPage.content_panels + [
        PageChooserPanel('archer_page', 'scoring.Archer'),
    ]

    promote_panels = WebPage.promote_panels + [
        PublishingPanel(),
    ]
    
    settings_panels = WebPage.settings_panels   + [
        MultiFieldPanel(
            [
                FieldPanel('slug'),
          ],
            heading="Extra Information",
            classname="collapsible collapsed",
        ), 
    ]

